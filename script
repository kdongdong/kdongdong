  $("reservoir-error").hidden = !selectedBuilding || state.valid;
  $("reservoir-error").textContent = "인원은 1명 이상, 용량은 0.01L 이상으로 입력하세요.";
  const source = !selectedBuilding
    ? "건물 선택 대기"
    : state.isEstimate
      ? "선택한 건물의 인원과 용도로 구한 저수조입니다. 절수안은 이 용량으로 단수 시간을 늘리는 조합입니다."
      : "사용자 직접 입력 용량 기반 계산입니다.";
