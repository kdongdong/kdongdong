async function reverseProfile(lat, lon) {
  const response = await fetch(`https://photon.komoot.io/reverse?lat=${lat}&lon=${lon}`, { signal: AbortSignal.timeout(8000) });
  if (!response.ok) throw new Error(`reverse ${response.status}`);
  const data = await response.json();
  const feature = (data.features || [])[0];
  return feature ? profileFromFeature(feature, lat, lon) : null;
}

async function selectAt(lat, lon) {
  const token = ++lookupToken;
  writeMapStatus("클릭한 위치의 건물을 확인하는 중입니다.", true);
  let source = "";
  const osmPromise = queryBuilding(lat, lon).catch(() => null);
  const placePromise = reverseProfile(lat, lon).catch(() => null);
  placePromise.then((profile) => {
    if (token !== lookupToken || !profile || source === "osm") return;
    source = "place";
    applyProfile(profile, profile.geometry || null);
  });
  osmPromise.then((element) => {
    if (token !== lookupToken || !element) return;
    source = "osm";
    applyProfile(buildProfile(element), element.geometry);
  });
  await Promise.allSettled([osmPromise, placePromise]);
  if (token !== lookupToken || source) return;
  writeMapStatus("이 위치에서 건물 윤곽을 찾지 못했습니다. 건물 위를 다시 클릭하세요.", true);
}

