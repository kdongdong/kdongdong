function validNumberInput(id) {
  const field = $(id);
  const valid = field.value.trim() !== "" && Number.isFinite(field.valueAsNumber) && field.checkValidity();
  field.setAttribute("aria-invalid", String(!valid));
  return valid;
}

function profileFor(tags) {
  const amenity = tags.amenity || "";
  const building = tags.building && tags.building !== "yes" ? tags.building : "";
  return PROFILES[amenity] || PROFILES[building] || PROFILES[tags.tourism] || PROFILES.default;
}

function readLevels(tags) {
  const raw = Number.parseFloat(tags["building:levels"]);
  if (Number.isFinite(raw) && raw > 0) return { levels: raw, text: `지상 약 ${number(raw, 1)}층` };
  const height = Number.parseFloat(String(tags.height || "").replace(/m$/i, ""));
  if (Number.isFinite(height) && height > 0) {
    const levels = Math.max(1, Math.round(height / 3.3));
    return { levels, text: `높이 ${number(height, 1)}m → 약 ${levels}층` };
  }
  return { levels: 1, text: "층수 정보 없음 · 1층으로 추정" };
}

function ringArea(geometry) {
  if (!geometry || geometry.length < 3) return 0;
  const lat0 = geometry[0].lat * Math.PI / 180;
  const mLat = 111320;
  const mLon = 111320 * Math.cos(lat0);
  let sum = 0;
  for (let i = 0; i < geometry.length; i += 1) {
    const a = geometry[i];
    const b = geometry[(i + 1) % geometry.length];
    sum += (a.lon * mLon) * (b.lat * mLat) - (b.lon * mLon) * (a.lat * mLat);
  }
  return Math.abs(sum) / 2;
}

function centroid(geometry) {
  const total = geometry.reduce((sum, point) => ({ lat: sum.lat + point.lat, lon: sum.lon + point.lon }), { lat: 0, lon: 0 });
  return [total.lat / geometry.length, total.lon / geometry.length];
}

function pointInRing(point, ring) {
  let inside = false;
  for (let i = 0, j = ring.length - 1; i < ring.length; j = i, i += 1) {
    const yi = ring[i].lat;
    const xi = ring[i].lon;
    const yj = ring[j].lat;
    const xj = ring[j].lon;
    const intersect = ((yi > point.lat) !== (yj > point.lat))
      && (point.lon < (xj - xi) * (point.lat - yi) / ((yj - yi) || 1e-12) + xi);
    if (intersect) inside = !inside;
  }
  return inside;
}

function buildingTitle(tags) {
  const named = tags["name:ko"] || tags.name || tags["addr:housename"];
  if (named) return named;
  const street = [tags["addr:street"], tags["addr:housenumber"]].filter(Boolean).join(" ");
  return street || "이름 없는 건물";
}

function buildProfile(element) {
  const tags = element.tags || {};
  const spec = profileFor(tags);
  const levels = readLevels(tags);
  const footprint = ringArea(element.geometry);
  const gfa = footprint * levels.levels;
  let people;
  let peopleSource;
  const capacity = Number.parseFloat(tags.capacity);
  const flats = Number.parseFloat(tags["building:flats"]);
  if (Number.isFinite(capacity) && capacity >= 1) {
    people = Math.round(capacity);
    peopleSource = "OpenStreetMap capacity 태그";
  } else if (Number.isFinite(flats) && flats >= 1) {
    people = Math.max(1, Math.round(flats * 2.3));
    peopleSource = `세대 ${number(flats, 0)} × 2.3명`;
  } else {
    people = Math.max(1, Math.round(gfa / spec.density));
    peopleSource = `바닥면적 ${number(footprint, 0)}㎡ × ${number(levels.levels, 1)}층 ÷ ${spec.density}㎡/명`;
  }
  const sized = waterStandard(people, spec.lpcd);
  return {
    name: buildingTitle(tags),
    use: spec.label,
    people,
    peopleSource,
    areaText: `바닥 ${number(footprint, 0)}㎡ · 연면적 약 ${number(gfa, 0)}㎡`,
    floors: levels.text,
    litersPerPerson: spec.lpcd,
    tankFraction: TANK_SHARE,
    dailyDesign: sized.daily,
    tankCapacity: sized.tank,
    drawingLiters: null,
    usages: USAGE_SETS[spec.usages],
    coordinates: centroid(element.geometry),
    osmUrl: `https://www.openstreetmap.org/${element.type || "way"}/${element.id}`,
    sourceLabel: "윤곽은 OpenStreetMap, 저수조는 설계기준",
    note: `이 건물의 공개 도면에서 저수조 리터를 확인하지 못했습니다. 저수조 ${number(sized.tank, 0)}L는 계획 1일 급수량 ${number(sized.daily, 0)}L의 5/10입니다. 인당 하루 급수량은 ${spec.lpcd}L, 인당 저수량은 ${number(sized.perPersonTank)}L입니다.`,
    extra: tags.building && tags.building !== "yes" ? `OSM building=${tags.building}` : "OSM에 세부 용도 태그가 없어 일반 가정값을 사용했습니다.",
    links: [["OpenStreetMap", `https://www.openstreetmap.org/${element.type || "way"}/${element.id}`]]
  };
}

