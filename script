    const sizedNow = state.sized || waterStandard(state.people || selectedBuilding.people, selectedBuilding.litersPerPerson);
    $("capacity-provenance").textContent = state.isEstimate
      ? `계획 1일 급수량 ${number(sizedNow.daily, 0)}L ÷ ${number(state.people || selectedBuilding.people, 0)}명 = 인당 ${number(sizedNow.perPersonDaily, 0)}L. 저수조 ${number(sizedNow.tank, 0)}L는 그 계획량의 5/10이고, 인당 저수량은 ${number(sizedNow.perPersonTank)}L입니다. 공개 도면에 적힌 저수조 용량이 아닙니다.`
      : "직접 입력한 용량으로 계산합니다. 인당 저수량은 이 용량을 인원으로 나눈 값입니다.";
  }
  $("effective-storage").textContent = state.valid ? `${number(state.storage)} L` : "—";
  $("storage-formula").textContent = state.valid
