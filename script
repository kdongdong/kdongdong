function waterStandard(people, litersPerPerson) {
  const count = Math.max(1, people);
  const daily = count * litersPerPerson;
  const tank = Math.round(daily * TANK_SHARE);
  return { daily, tank, perPersonDaily: litersPerPerson, perPersonTank: tank / count };
}

