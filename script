    $("diagnosis-result").innerHTML = '<div class="diagnosis-summary warning"><strong>진단 대기</strong><p>건물을 선택하면 저수조 유효용량으로 절수안을 계산합니다. 수위계 기록이 있을 때만 아래를 채우세요.</p></div>';
    hideNotes();
    return;
  }
  const fields = ["observation-hours", "previous-level", "observed-level", "meter-volume", "recent-average"];
  const filled = fields.every((id) => $(id).value.trim() !== "");
