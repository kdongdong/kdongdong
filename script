  const isEstimate = $("capacity-mode").value === "estimate";
  const sized = peopleOk ? waterStandard(people, selectedBuilding.litersPerPerson) : null;
  const estimateCapacity = sized ? sized.tank : NaN;
  const capacityValid = isEstimate ? peopleOk : validNumberInput("capacity-input");
  const capacity = isEstimate ? estimateCapacity : $("capacity-input").valueAsNumber;
