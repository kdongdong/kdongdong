function geometryFromBounds(bounds) {
  if (!bounds) return null;
  return [
    { lat: bounds.minlat, lon: bounds.minlon },
    { lat: bounds.minlat, lon: bounds.maxlon },
    { lat: bounds.maxlat, lon: bounds.maxlon },
    { lat: bounds.maxlat, lon: bounds.minlon }
  ];
}

function boundsContain(bounds, lat, lon) {
  return bounds && lat >= bounds.minlat && lat <= bounds.maxlat && lon >= bounds.minlon && lon <= bounds.maxlon;
}

async function postOverpass(query) {
  const endpoints = [
    "https://overpass-api.de/api/interpreter",
    "https://overpass.kumi.systems/api/interpreter"
  ];
  const attempts = endpoints.map(async (endpoint) => {
    const response = await fetch(endpoint, {
      method: "POST",
      headers: { "Content-Type": "text/plain;charset=UTF-8" },
      body: query,
      signal: AbortSignal.timeout(8000)
    });
    if (!response.ok) throw new Error(`overpass ${response.status}`);
    return response.json();
  });
  return Promise.any(attempts);
}

async function queryBuilding(lat, lon) {
  const query = `[out:json][timeout:8];way(around:70,${lat},${lon})["building"];out tags bb;`;
  const data = await postOverpass(query);
  const ways = (data.elements || []).filter((element) => element.tags && element.tags.building && element.bounds);
  if (!ways.length) return null;
  ways.forEach((element) => { element.geometry = geometryFromBounds(element.bounds); });
  const containing = ways.filter((element) => boundsContain(element.bounds, lat, lon));
  const pool = containing.length ? containing : ways;
  pool.sort((a, b) => ringArea(a.geometry) - ringArea(b.geometry));
  if (containing.length) return pool[0];
  pool.sort((a, b) => {
    const ca = centroid(a.geometry);
    const cb = centroid(b.geometry);
    return ((ca[0] - lat) ** 2 + (ca[1] - lon) ** 2) - ((cb[0] - lat) ** 2 + (cb[1] - lon) ** 2);
  });
  return pool[0];
}

function profileFromFeature(feature, lat, lon) {
  const props = feature.properties || {};
  const tags = { building: "yes" };
  if (props.osm_key === "building" && props.osm_value) tags.building = props.osm_value;
  if (props.osm_key === "amenity" && props.osm_value) tags.amenity = props.osm_value;
  const spec = profileFor(tags);
  let footprint = 800;
  let geometry = null;
  let areaText = "면적 정보 없음 · 바닥 800㎡로 가정";
  if (Array.isArray(props.extent) && props.extent.length === 4) {
    const [west, north, east, south] = props.extent;
    const ring = [
      { lat: south, lon: west },
      { lat: south, lon: east },
      { lat: north, lon: east },
      { lat: north, lon: west }
    ];
    const area = ringArea(ring);
    if (area >= 30 && area <= 20000) {
      footprint = area;
      geometry = ring;
      areaText = `위치 범위 약 ${number(footprint, 0)}㎡`;
    }
  }
  const people = Math.max(1, Math.round(footprint / spec.density));
  const sized = waterStandard(people, spec.lpcd);
  const name = props.name || [props.street, props.housenumber].filter(Boolean).join(" ") || "선택한 건물";
  const osmType = props.osm_type === "W" ? "way" : props.osm_type === "R" ? "relation" : "node";
  return {
    name,
    use: spec.label,
    people,
    peopleSource: `위치 검색 면적 ${number(footprint, 0)}㎡ ÷ ${spec.density}㎡/명`,
    areaText,
    floors: "층수 정보 없음 · 1층으로 추정",
    litersPerPerson: spec.lpcd,
    tankFraction: TANK_SHARE,
    dailyDesign: sized.daily,
    tankCapacity: sized.tank,
    drawingLiters: null,
    usages: USAGE_SETS[spec.usages],
    coordinates: feature.geometry && feature.geometry.coordinates
      ? [feature.geometry.coordinates[1], feature.geometry.coordinates[0]]
      : [lat, lon],
    osmUrl: props.osm_id ? `https://www.openstreetmap.org/${osmType}/${props.osm_id}` : `https://www.openstreetmap.org/#map=18/${lat}/${lon}`,
    sourceLabel: "클릭 위치의 가장 가까운 장소",
    note: `공개 도면의 저수조 용량은 없습니다. 저수조 ${number(sized.tank, 0)}L = 계획 1일 급수량 ${number(sized.daily, 0)}L × 5/10. 인당 하루 급수량 ${spec.lpcd}L, 인당 저수량 ${number(sized.perPersonTank)}L입니다. 층수를 모르면 1층으로 보아 인원이 작을 수 있습니다.`,
    extra: props.city ? `${props.city}` : `${lat.toFixed(5)}, ${lon.toFixed(5)}`,
    links: [["OpenStreetMap", props.osm_id ? `https://www.openstreetmap.org/${osmType}/${props.osm_id}` : `https://www.openstreetmap.org/#map=18/${lat}/${lon}`]],
    geometry
  };
}

